#!/bin/bash

set -e

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"

ACTION="$1"
ASSET="$2"

case "$ACTION" in

  build)
    case "$ASSET" in
      BM-001)
        echo "Building BM-001 — Hanten World / Equal Earth"
        source ".venv-cartography/bin/activate"
        python3 "04 Shared Assets/build/scripts/build_bm001.py"
        ;;
      *)
        echo "Unknown asset: $ASSET"
        exit 1
        ;;
    esac
    ;;

  validate)
    source ".venv-cartography/bin/activate"
    python3 "04 Shared Assets/build/scripts/validate_basemap.py" "$ASSET"
    ;;

  *)
    echo "Hanten Build System v1.0"
    echo
    echo "Usage:"
    echo "  ./04\\ Shared\\ Assets/build/hanten-build build BM-001"
    echo "  ./04\\ Shared\\ Assets/build/hanten-build validate BM-001"
    echo
    exit 1
    ;;
esac
